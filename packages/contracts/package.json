{
  "name": "@seyra/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Map Services API contracts (TypeBox/JSON Schema), limits, error codes and search normalization",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
