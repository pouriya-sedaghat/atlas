# Copy to a VM-managed location and pass it to docker compose with --env-file.
ATLAS_POSTGRES_DIR=/srv/atlas/data/postgres
ATLAS_INBOX_DIR=/srv/atlas/data/inbox
ATLAS_VERIFICATION_DIR=/srv/atlas/data/verification
ATLAS_SECRET_DIR=/srv/atlas/secrets
ATLAS_WEB_PORT=8000
ATLAS_ZONE=Asia/Tehran
ATLAS_MAX_PBF_BYTES=1073741824
ATLAS_MAX_POLY_BYTES=2097152
ATLAS_MAX_RUN_BYTES=2147483648
ATLAS_MAX_INBOX_BYTES=53687091200
ATLAS_MIN_FREE_BYTES=21474836480
ATLAS_VERIFICATION_TIMEOUT=3600
ATLAS_VERIFICATION_ATTEMPT_BYTES=21474836480
ATLAS_VERIFICATION_ROOT_BYTES=64424509440
ATLAS_ALLOWED_HOSTS=localhost,127.0.0.1
ATLAS_CSRF_TRUSTED_ORIGINS=
ATLAS_SECURE_COOKIES=0
ATLAS_TRUST_FORWARDED_PROTO=0
ATLAS_SSL_REDIRECT=0
