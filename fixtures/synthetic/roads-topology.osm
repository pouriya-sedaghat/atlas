<?xml version="1.0" encoding="UTF-8"?>
<!--
  Atlas synthetic topology fixture.

  Hand written, deliberately small, and laid out as ten disconnected groups so
  that every topology rule can be read off the file and pinned exactly. Nothing
  here was downloaded from OpenStreetMap: the coordinates are invented and each
  group sits in its own longitude band purely so that the groups cannot touch
  one another by accident.

  The only connectivity key is the source point identity. Two points at one
  coordinate are not joined, two lines that cross on the page are not joined,
  and no tag — oneway, access, maxspeed, barrier, junction, class — is ever
  consulted to decide what is joined to what.

  The cases, by group:

    Simple road ................ way 601, nodes 1-2-3
                                 2 is a shape point, not a node
    T junction ................. ways 602, 603, 604 meeting at node 5
    Shared-node cross .......... ways 605, 606 crossing at node 9
    Geometric-only cross ....... ways 607, 608 crossing on the page only
    Roundabout and approaches .. closed way 609, approaches 610, 611
    Repeated internal node ..... way 612 revisiting node 23
    Non-road sharing a point ... road 613 and non-road 900 at node 27
    Missing reference .......... way 614 naming node 999, which is absent
    Reverse one-way ............ way 615, oneway=-1, never reversed
    One coordinate, two ids .... ways 616, 617; nodes 35 and 37 coincide

  Expected import outcome (asserted in
  crates/atlas-osm/tests/topology_fixture.rs):
    nodes seen ............ 38
    nodes indexed ......... 38
    ways seen ............. 18   (17 road candidates plus non-road 900)
    road ways selected .... 17
    features emitted ...... 16
    features skipped ...... 1    (way 614 names a node that is not here)
    relations seen ........ 1    (counted, never interpreted)
    topology nodes ........ 31
    topology segments ..... 22
    warnings .............. MISSING_NODE_REFERENCE 1  (way/614)
                            UNSUPPORTED_RELATION   1  (relation/700)
-->
<osm version="0.6" generator="atlas-synthetic-fixture">
  <bounds minlat="35.5990" minlon="51.3000" maxlat="35.6050" maxlon="51.3960"/>

  <!-- Simple road: one segment, and node 2 is only a shape point. -->
  <node id="1" lat="35.6000" lon="51.3000"/>
  <node id="2" lat="35.6010" lon="51.3010"/>
  <node id="3" lat="35.6020" lon="51.3020"/>

  <!-- T junction: three ways meet at node 5. -->
  <node id="4" lat="35.6000" lon="51.3100"/>
  <node id="5" lat="35.6000" lon="51.3120"/>
  <node id="6" lat="35.6010" lon="51.3140"/>
  <node id="7" lat="35.5990" lon="51.3140"/>

  <!-- Shared-node cross: two ways pass through node 9. -->
  <node id="8" lat="35.6000" lon="51.3200"/>
  <node id="9" lat="35.6020" lon="51.3220"/>
  <node id="10" lat="35.6040" lon="51.3240"/>
  <node id="11" lat="35.6040" lon="51.3200"/>
  <node id="12" lat="35.6000" lon="51.3240"/>

  <!-- Geometric-only cross: the lines cross at 51.3320/35.6020, which is not
       a node of either of them, so nothing is joined. -->
  <node id="13" lat="35.6000" lon="51.3300"/>
  <node id="14" lat="35.6040" lon="51.3340"/>
  <node id="15" lat="35.6040" lon="51.3300"/>
  <node id="16" lat="35.6000" lon="51.3340"/>

  <!-- Roundabout and its two approaches. -->
  <node id="17" lat="35.6000" lon="51.3400"/>
  <node id="18" lat="35.6020" lon="51.3420"/>
  <node id="19" lat="35.6000" lon="51.3440"/>
  <node id="20" lat="35.6050" lon="51.3420"/>
  <node id="21" lat="35.6000" lon="51.3470"/>

  <!-- Repeated internal node: node 23 is visited twice by one way. -->
  <node id="22" lat="35.6000" lon="51.3500"/>
  <node id="23" lat="35.6000" lon="51.3520"/>
  <node id="24" lat="35.6020" lon="51.3530"/>
  <node id="25" lat="35.6000" lon="51.3550"/>

  <!-- Non-road sharing a point: node 27 is on both way 613 and way 900. -->
  <node id="26" lat="35.6000" lon="51.3600"/>
  <node id="27" lat="35.6000" lon="51.3620"/>
  <node id="28" lat="35.6000" lon="51.3640"/>
  <node id="29" lat="35.6030" lon="51.3620"/>

  <!-- Missing reference: node 30 exists, node 999 deliberately does not. -->
  <node id="30" lat="35.6000" lon="51.3700"/>

  <!-- Reverse one-way. -->
  <node id="31" lat="35.6000" lon="51.3800"/>
  <node id="32" lat="35.6010" lon="51.3820"/>
  <node id="33" lat="35.6020" lon="51.3840"/>

  <!-- One coordinate, two identities: node 37 sits exactly on node 35. -->
  <node id="34" lat="35.6000" lon="51.3900"/>
  <node id="35" lat="35.6020" lon="51.3920"/>
  <node id="36" lat="35.6040" lon="51.3940"/>
  <node id="37" lat="35.6020" lon="51.3920"/>
  <node id="38" lat="35.6000" lon="51.3960"/>

  <!-- Simple road. Nodes 1 and 3 are endpoints; node 2 is visited once, in
       the middle of one way, so it stays a shape coordinate. -->
  <way id="601">
    <nd ref="1"/>
    <nd ref="2"/>
    <nd ref="3"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Simple Road"/>
  </way>

  <!-- T junction. Node 5 is seen three times across three ways, so it is a
       node of degree three and each way becomes one segment. -->
  <way id="602">
    <nd ref="4"/>
    <nd ref="5"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="T Stem"/>
  </way>
  <way id="603">
    <nd ref="5"/>
    <nd ref="6"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="T Left Arm"/>
  </way>
  <way id="604">
    <nd ref="5"/>
    <nd ref="7"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="T Right Arm"/>
  </way>

  <!-- Shared-node cross. Node 9 is internal to both ways and seen twice, so
       it is promoted and splits both of them: four segments, degree four. -->
  <way id="605">
    <nd ref="8"/>
    <nd ref="9"/>
    <nd ref="10"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Cross North East"/>
  </way>
  <way id="606">
    <nd ref="11"/>
    <nd ref="9"/>
    <nd ref="12"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Cross South East"/>
  </way>

  <!-- Geometric-only cross. The two lines intersect on the page and share no
       node, so they stay two disconnected segments. Geometry is not
       connectivity. -->
  <way id="607">
    <nd ref="13"/>
    <nd ref="14"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Overpass Way"/>
  </way>
  <way id="608">
    <nd ref="15"/>
    <nd ref="16"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Underpass Way"/>
  </way>

  <!-- Roundabout: a closed way whose first and last reference are node 17.
       Nodes 18 and 19 are shared with the approaches, so the ring splits into
       three segments rather than becoming one self-loop.

       `junction=roundabout` is here to be ignored by the topology. It is read
       by the direction derivation, which is a separate fact on the road; it
       decides nothing about what is joined to what. -->
  <way id="609">
    <nd ref="17"/>
    <nd ref="18"/>
    <nd ref="19"/>
    <nd ref="17"/>
    <tag k="highway" v="residential"/>
    <tag k="junction" v="roundabout"/>
    <tag k="name" v="Ring Road"/>
  </way>
  <way id="610">
    <nd ref="20"/>
    <nd ref="18"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="North Approach"/>
  </way>
  <way id="611">
    <nd ref="19"/>
    <nd ref="21"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="East Approach"/>
  </way>

  <!-- Repeated internal node. Node 23 is seen twice inside one way, so both
       occurrences split it: three segments, of which the middle one leaves
       node 23 and comes back to it. Node 24 is seen once and stays a shape
       coordinate. -->
  <way id="612">
    <nd ref="22"/>
    <nd ref="23"/>
    <nd ref="24"/>
    <nd ref="23"/>
    <nd ref="25"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Lollipop Lane"/>
  </way>

  <!-- Non-road sharing a point. Way 900 has no highway tag, so it produces no
       feature, no warning and no path — and therefore cannot make node 27
       occur twice. The road stays one segment. -->
  <way id="613">
    <nd ref="26"/>
    <nd ref="27"/>
    <nd ref="28"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Fenced Road"/>
  </way>
  <way id="900">
    <nd ref="27"/>
    <nd ref="29"/>
    <tag k="barrier" v="fence"/>
  </way>

  <!-- Missing reference. The road is skipped with the existing warning, and a
       skipped road contributes no path, so node 30 never becomes a node. -->
  <way id="614">
    <nd ref="30"/>
    <nd ref="999"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Broken Road"/>
  </way>

  <!-- Reverse one-way. The direction is a fact on the road; the topology
       keeps the coordinates in the source's own order and never turns the
       segment around to match the way the traffic runs. -->
  <way id="615">
    <nd ref="31"/>
    <nd ref="32"/>
    <nd ref="33"/>
    <tag k="highway" v="residential"/>
    <tag k="oneway" v="-1"/>
    <tag k="name" v="Reverse Street"/>
  </way>

  <!-- One coordinate, two identities. Node 37 sits exactly on node 35 and is
       a different point, so the two ways stay disconnected and the two ids
       are never merged. Node 35 is seen once, internally, so it is a shape
       coordinate; node 37 starts a way, so it is a node. -->
  <way id="616">
    <nd ref="34"/>
    <nd ref="35"/>
    <nd ref="36"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Upper Terrace"/>
  </way>
  <way id="617">
    <nd ref="37"/>
    <nd ref="38"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Lower Terrace"/>
  </way>

  <!-- A restriction-shaped relation. Atlas counts it and reports it as
       unsupported; it is never interpreted, and turn restrictions have no
       bearing on structural topology. -->
  <relation id="700">
    <member type="way" ref="602" role="from"/>
    <member type="node" ref="5" role="via"/>
    <member type="way" ref="603" role="to"/>
    <tag k="type" v="restriction"/>
    <tag k="restriction" v="no_left_turn"/>
  </relation>
</osm>
