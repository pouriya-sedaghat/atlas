<?xml version="1.0" encoding="UTF-8"?>
<!--
  Atlas synthetic access fixture.

  Hand written and deliberately schematic: every road is a short straight
  segment on its own row, running west to east, so each access rule can be
  seen on its own in Atlas Studio without any road overlapping another. The
  rows run north to south in way-id order, 401 at the top and 423 at the
  bottom.

  Nothing in this file was downloaded from OpenStreetMap. The coordinates are
  invented and sit in an empty part of Tehran purely so that the numbers look
  plausible in the viewer.

  Every way here imports cleanly: there are no skipped features, no invalid
  coordinates, no unknown highway classes and no relations, so the only
  warnings are the three access warnings. That is what makes them easy to
  read off in Studio.

  Expected import outcome (asserted in
  crates/atlas-osm/tests/access_fixture.rs):
    nodes seen ............ 69
    nodes indexed ......... 69
    ways seen ............. 23
    road ways selected .... 23
    features emitted ...... 23
    features skipped ...... 0
    relations seen ........ 0

  Expected warnings, in the order the API reports them:
    UNKNOWN_ACCESS_VALUE ............. 1   way/417
    INVALID_ACCESS_SCOPE ............. 1   way/423
    UNSUPPORTED_CONDITIONAL_ACCESS ... 4   way/418, way/419, way/420, way/421

  Expected access per way, as motorcar / bicycle / foot:
    401 Untagged Lane ....................... unspecified       / unspecified       / unspecified
    402 Open Access Street .................. allowed           / allowed           / allowed
    403 Closed Access Street ................ prohibited        / prohibited        / prohibited
    404 Foot Exception Street ............... prohibited        / prohibited        / allowed
    405 Cycle Exception Street .............. prohibited        / allowed           / unspecified
    406 Destination Motor Road .............. destination-only  / unspecified       / unspecified
    407 Layered Override Street ............. private           / permissive        / allowed
    408 Designated Cycleway ................. unspecified       / designated        / unspecified
    409 Permissive Footpath ................. unspecified       / unspecified       / permissive
    410 Customers Car Park Road ............. customers-only    / customers-only    / customers-only
    411 Delivery Service Road ............... delivery-only     / unspecified       / unspecified
    412 Dismount Bridge Path ................ unspecified       / dismount-required / unspecified
    413 Sidepath Cycle Street ............... unspecified       / use-sidepath      / unspecified
    414 Permit Motorcar Track ............... permit-required   / unspecified       / unspecified
    415 Discouraged Cycle Lane .............. unspecified       / discouraged       / unspecified
    416 Unknown Access Road ................. indeterminate     / indeterminate     / indeterminate
    417 Unreadable Motorcar Street .......... indeterminate     / allowed           / allowed
    418 Conditional Access Street ........... conditional       / conditional       / conditional
    419 Conditional With Foot Exception ..... conditional       / conditional       / allowed
    420 Conditional Vehicle Street .......... allowed           / conditional       / unspecified
    421 Conditional Motorcar Street ......... conditional       / unspecified       / unspecified
    422 Variable Access Street .............. variable          / variable          / variable
    423 Invalid Scope Street ................ indeterminate     / indeterminate     / indeterminate

  Access is not direction. A few ways carry an orthogonal `oneway` tag so
  that the access overlay and the direction arrows can be watched together;
  neither derivation reads the other's tags, and the directions below are
  exactly what the same tags would produce with no access tag present:
    403 Closed Access Street — oneway=yes
    407 Layered Override Street — oneway=-1
    408 Designated Cycleway — oneway=yes
    418 Conditional Access Street — oneway=yes

  Every other way has no direction tag, so it is two-way for every mode.

  None of these rules says whether a router may use the road. They record
  what the source said. A later routing profile will decide what a
  destination restriction or a permit requirement means for a given journey,
  in a given country, for a given vehicle.
-->
<osm version="0.6" generator="atlas-synthetic-fixture">
  <bounds minlat="35.6990" minlon="51.3900" maxlat="35.7100" maxlon="51.3930"/>

  <!-- Three nodes per road, one row per way, in way order. -->
  <node id="1" lat="35.7100" lon="51.3900"/>
  <node id="2" lat="35.7100" lon="51.3915"/>
  <node id="3" lat="35.7100" lon="51.3930"/>
  <node id="4" lat="35.7095" lon="51.3900"/>
  <node id="5" lat="35.7095" lon="51.3915"/>
  <node id="6" lat="35.7095" lon="51.3930"/>
  <node id="7" lat="35.7090" lon="51.3900"/>
  <node id="8" lat="35.7090" lon="51.3915"/>
  <node id="9" lat="35.7090" lon="51.3930"/>
  <node id="10" lat="35.7085" lon="51.3900"/>
  <node id="11" lat="35.7085" lon="51.3915"/>
  <node id="12" lat="35.7085" lon="51.3930"/>
  <node id="13" lat="35.7080" lon="51.3900"/>
  <node id="14" lat="35.7080" lon="51.3915"/>
  <node id="15" lat="35.7080" lon="51.3930"/>
  <node id="16" lat="35.7075" lon="51.3900"/>
  <node id="17" lat="35.7075" lon="51.3915"/>
  <node id="18" lat="35.7075" lon="51.3930"/>
  <node id="19" lat="35.7070" lon="51.3900"/>
  <node id="20" lat="35.7070" lon="51.3915"/>
  <node id="21" lat="35.7070" lon="51.3930"/>
  <node id="22" lat="35.7065" lon="51.3900"/>
  <node id="23" lat="35.7065" lon="51.3915"/>
  <node id="24" lat="35.7065" lon="51.3930"/>
  <node id="25" lat="35.7060" lon="51.3900"/>
  <node id="26" lat="35.7060" lon="51.3915"/>
  <node id="27" lat="35.7060" lon="51.3930"/>
  <node id="28" lat="35.7055" lon="51.3900"/>
  <node id="29" lat="35.7055" lon="51.3915"/>
  <node id="30" lat="35.7055" lon="51.3930"/>
  <node id="31" lat="35.7050" lon="51.3900"/>
  <node id="32" lat="35.7050" lon="51.3915"/>
  <node id="33" lat="35.7050" lon="51.3930"/>
  <node id="34" lat="35.7045" lon="51.3900"/>
  <node id="35" lat="35.7045" lon="51.3915"/>
  <node id="36" lat="35.7045" lon="51.3930"/>
  <node id="37" lat="35.7040" lon="51.3900"/>
  <node id="38" lat="35.7040" lon="51.3915"/>
  <node id="39" lat="35.7040" lon="51.3930"/>
  <node id="40" lat="35.7035" lon="51.3900"/>
  <node id="41" lat="35.7035" lon="51.3915"/>
  <node id="42" lat="35.7035" lon="51.3930"/>
  <node id="43" lat="35.7030" lon="51.3900"/>
  <node id="44" lat="35.7030" lon="51.3915"/>
  <node id="45" lat="35.7030" lon="51.3930"/>
  <node id="46" lat="35.7025" lon="51.3900"/>
  <node id="47" lat="35.7025" lon="51.3915"/>
  <node id="48" lat="35.7025" lon="51.3930"/>
  <node id="49" lat="35.7020" lon="51.3900"/>
  <node id="50" lat="35.7020" lon="51.3915"/>
  <node id="51" lat="35.7020" lon="51.3930"/>
  <node id="52" lat="35.7015" lon="51.3900"/>
  <node id="53" lat="35.7015" lon="51.3915"/>
  <node id="54" lat="35.7015" lon="51.3930"/>
  <node id="55" lat="35.7010" lon="51.3900"/>
  <node id="56" lat="35.7010" lon="51.3915"/>
  <node id="57" lat="35.7010" lon="51.3930"/>
  <node id="58" lat="35.7005" lon="51.3900"/>
  <node id="59" lat="35.7005" lon="51.3915"/>
  <node id="60" lat="35.7005" lon="51.3930"/>
  <node id="61" lat="35.7000" lon="51.3900"/>
  <node id="62" lat="35.7000" lon="51.3915"/>
  <node id="63" lat="35.7000" lon="51.3930"/>
  <node id="64" lat="35.6995" lon="51.3900"/>
  <node id="65" lat="35.6995" lon="51.3915"/>
  <node id="66" lat="35.6995" lon="51.3930"/>
  <node id="67" lat="35.6990" lon="51.3900"/>
  <node id="68" lat="35.6990" lon="51.3915"/>
  <node id="69" lat="35.6990" lon="51.3930"/>

  <!--
       No access tag of any kind. Silence is not permission: every mode is
       `unspecified`, which is a different fact from `allowed`.
  -->
  <way id="401">
    <nd ref="1"/>
    <nd ref="2"/>
    <nd ref="3"/>
    <tag k="name" v="Untagged Lane"/>
    <tag k="highway" v="residential"/>
  </way>

  <!-- The general key, open. It reaches every mode at once. -->
  <way id="402">
    <nd ref="4"/>
    <nd ref="5"/>
    <nd ref="6"/>
    <tag k="name" v="Open Access Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="yes"/>
  </way>

  <!--
       The general key, closed, on a forward one-way street. Access and
       direction are independent: Studio still draws the arrows for Car and
       Bicycle over the prohibited overlay.
  -->
  <way id="403">
    <nd ref="7"/>
    <nd ref="8"/>
    <nd ref="9"/>
    <tag k="name" v="Closed Access Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="no"/>
    <tag k="oneway" v="yes"/>
  </way>

  <!--
       A closed street re-opened for pedestrians. The specific `foot` key
       out-ranks the general one for foot, and for foot only.
  -->
  <way id="404">
    <nd ref="10"/>
    <nd ref="11"/>
    <nd ref="12"/>
    <tag k="name" v="Foot Exception Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="no"/>
    <tag k="foot" v="yes"/>
  </way>

  <!--
       A vehicle prohibition with a cycle exception. `vehicle` never reaches
       a pedestrian, so foot stays unspecified rather than becoming allowed.
  -->
  <way id="405">
    <nd ref="13"/>
    <nd ref="14"/>
    <nd ref="15"/>
    <tag k="name" v="Cycle Exception Street"/>
    <tag k="highway" v="residential"/>
    <tag k="vehicle" v="no"/>
    <tag k="bicycle" v="yes"/>
  </way>

  <!-- `motor_vehicle` reaches the car and stops there. -->
  <way id="406">
    <nd ref="16"/>
    <nd ref="17"/>
    <nd ref="18"/>
    <tag k="name" v="Destination Motor Road"/>
    <tag k="highway" v="residential"/>
    <tag k="motor_vehicle" v="destination"/>
  </way>

  <!--
       Three levels at once, on a reverse one-way. The most specific key wins
       per mode: the car reads `motorcar`, the bicycle reads `vehicle` and the
       pedestrian falls all the way through to `access`.
  -->
  <way id="407">
    <nd ref="19"/>
    <nd ref="20"/>
    <nd ref="21"/>
    <tag k="name" v="Layered Override Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="yes"/>
    <tag k="vehicle" v="permissive"/>
    <tag k="motorcar" v="private"/>
    <tag k="oneway" v="-1"/>
  </way>

  <!--
       A designated cycleway that is also one-way. `designated` is perfectly
       valid on a mode-specific key, and the direction is its own fact.
  -->
  <way id="408">
    <nd ref="22"/>
    <nd ref="23"/>
    <nd ref="24"/>
    <tag k="name" v="Designated Cycleway"/>
    <tag k="highway" v="cycleway"/>
    <tag k="bicycle" v="designated"/>
    <tag k="oneway" v="yes"/>
  </way>

  <!-- Permitted by the owner, and potentially revocable. -->
  <way id="409">
    <nd ref="25"/>
    <nd ref="26"/>
    <nd ref="27"/>
    <tag k="name" v="Permissive Footpath"/>
    <tag k="highway" v="footway"/>
    <tag k="foot" v="permissive"/>
  </way>

  <!-- A purpose-limited general restriction, so it reaches every mode. -->
  <way id="410">
    <nd ref="28"/>
    <nd ref="29"/>
    <nd ref="30"/>
    <tag k="name" v="Customers Car Park Road"/>
    <tag k="highway" v="service"/>
    <tag k="access" v="customers"/>
  </way>

  <!-- Deliveries only, for motor vehicles only. -->
  <way id="411">
    <nd ref="31"/>
    <nd ref="32"/>
    <nd ref="33"/>
    <tag k="name" v="Delivery Service Road"/>
    <tag k="highway" v="service"/>
    <tag k="motor_vehicle" v="delivery"/>
  </way>

  <!--
       Cyclists must dismount. Valid on `bicycle`; it would be meaningless on
       the general key, which names no mode to dismount.
  -->
  <way id="412">
    <nd ref="34"/>
    <nd ref="35"/>
    <nd ref="36"/>
    <tag k="name" v="Dismount Bridge Path"/>
    <tag k="highway" v="path"/>
    <tag k="bicycle" v="dismount"/>
  </way>

  <!-- Cyclists are expected to use the parallel path instead. -->
  <way id="413">
    <nd ref="37"/>
    <nd ref="38"/>
    <nd ref="39"/>
    <tag k="name" v="Sidepath Cycle Street"/>
    <tag k="highway" v="residential"/>
    <tag k="bicycle" v="use_sidepath"/>
  </way>

  <!-- Motor cars need a permit; nothing is said about anybody else. -->
  <way id="414">
    <nd ref="40"/>
    <nd ref="41"/>
    <nd ref="42"/>
    <tag k="name" v="Permit Motorcar Track"/>
    <tag k="highway" v="track"/>
    <tag k="motorcar" v="permit"/>
  </way>

  <!-- Legal, but the source discourages it. Recorded, not judged. -->
  <way id="415">
    <nd ref="43"/>
    <nd ref="44"/>
    <nd ref="45"/>
    <tag k="name" v="Discouraged Cycle Lane"/>
    <tag k="highway" v="cycleway"/>
    <tag k="bicycle" v="discouraged"/>
  </way>

  <!--
       `unknown` is a recognised OSM value: a surveyor saying they could not
       tell. Atlas records `indeterminate` and raises no warning, because
       there is nothing wrong with the data.
  -->
  <way id="416">
    <nd ref="46"/>
    <nd ref="47"/>
    <nd ref="48"/>
    <tag k="name" v="Unknown Access Road"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="unknown"/>
  </way>

  <!--
       A value Atlas cannot read on a specific key. The car becomes
       indeterminate and never falls back to the perfectly readable `access`
       below it, because the mapper meant to say something about motorcars.
       Earns UNKNOWN_ACCESS_VALUE.
  -->
  <way id="417">
    <nd ref="49"/>
    <nd ref="50"/>
    <nd ref="51"/>
    <tag k="name" v="Unreadable Motorcar Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="yes"/>
    <tag k="motorcar" v="maybe"/>
  </way>

  <!--
       A conditional on the general key, on a forward one-way. The expression
       is detected by key and never read, so every mode is `conditional` —
       never a plain yes or no. Earns UNSUPPORTED_CONDITIONAL_ACCESS.
  -->
  <way id="418">
    <nd ref="52"/>
    <nd ref="53"/>
    <nd ref="54"/>
    <tag k="name" v="Conditional Access Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access:conditional" v="no @ (Mo-Fr 07:00-09:00)"/>
    <tag k="oneway" v="yes"/>
  </way>

  <!--
       The same conditional, out-ranked for foot by a plain `foot=yes`. A
       more specific static value beats a broader conditional.
  -->
  <way id="419">
    <nd ref="55"/>
    <nd ref="56"/>
    <nd ref="57"/>
    <tag k="name" v="Conditional With Foot Exception"/>
    <tag k="highway" v="residential"/>
    <tag k="access:conditional" v="no @ (Mo-Fr 07:00-09:00,16:00-18:00)"/>
    <tag k="foot" v="yes"/>
  </way>

  <!--
       A vehicle conditional with a specific motorcar exception. The car
       reads its own key, the bicycle reaches the conditional, and the
       pedestrian is never reached by a vehicle key at all.
  -->
  <way id="420">
    <nd ref="58"/>
    <nd ref="59"/>
    <nd ref="60"/>
    <tag k="name" v="Conditional Vehicle Street"/>
    <tag k="highway" v="residential"/>
    <tag k="vehicle:conditional" v="no @ (Mo-Fr 07:00-19:00)"/>
    <tag k="motorcar" v="yes"/>
  </way>

  <!--
       A conditional and a static value on the same key. At one specificity
       level the conditional form wins, so the car is `conditional` and the
       `motorcar=yes` beside it is not the answer.
  -->
  <way id="421">
    <nd ref="61"/>
    <nd ref="62"/>
    <nd ref="63"/>
    <tag k="name" v="Conditional Motorcar Street"/>
    <tag k="highway" v="residential"/>
    <tag k="motorcar" v="yes"/>
    <tag k="motorcar:conditional" v="no @ (Sa-Su 10:00-18:00)"/>
  </way>

  <!--
       The source says plainly that access varies. That is a fact Atlas can
       record, and it is not the same as being unable to read one.
  -->
  <way id="422">
    <nd ref="64"/>
    <nd ref="65"/>
    <nd ref="66"/>
    <tag k="name" v="Variable Access Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="variable"/>
  </way>

  <!--
       `designated` on the general key names no mode: designated for whom?
       Every mode that reaches it becomes indeterminate rather than guessing.
       Earns INVALID_ACCESS_SCOPE.
  -->
  <way id="423">
    <nd ref="67"/>
    <nd ref="68"/>
    <nd ref="69"/>
    <tag k="name" v="Invalid Scope Street"/>
    <tag k="highway" v="residential"/>
    <tag k="access" v="designated"/>
  </way>
</osm>
