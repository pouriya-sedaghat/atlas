{
  "name": "@seyra/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seyra Map Services gateway (Fastify 5): provider adapters, bounded execution, readiness gate",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "node dist/openapi.js ../../docs/openapi/map-services-v1.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "5.2.6",
    "@fastify/type-provider-typebox": "6.3.0",
    "@seyra/contracts": "1.0.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
