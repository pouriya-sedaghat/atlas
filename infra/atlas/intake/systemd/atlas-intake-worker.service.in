[Unit]
Description=Atlas private PBF validation coordinator

[Service]
Type=simple
WorkingDirectory=@SOURCE_ROOT@
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
ExecStart=@NODE_BIN@/node @SOURCE_ROOT@/apps/ingest/dist/cli.js work --config @CONFIG@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=default.target
