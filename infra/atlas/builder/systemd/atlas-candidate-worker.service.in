[Unit]
Description=Atlas experimental PostGIS and Martin candidate builder

[Service]
Type=simple
WorkingDirectory=@SOURCE_ROOT@
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
ExecStart=@NODE_BIN@/node @SOURCE_ROOT@/apps/builder/dist/cli.js work --config @CONFIG@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
MemoryMax=768M
CPUQuota=100%

[Install]
WantedBy=default.target
