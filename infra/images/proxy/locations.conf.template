# Seyra ingress locations, included by every listener's server block (control and relay listeners
# share exactly the same routes; only their access rules differ). Rendered by seyra-proxy-render.
# JSON errors generated here use the API's error envelope; request_id is nginx's $request_id, which
# the access log records, so ingress errors can be correlated like API errors.
    client_max_body_size 64k;
    client_body_buffer_size 64k;
    large_client_header_buffers 4 8k;

    include /etc/seyra/security-headers.conf;

    # Oversized bodies are refused here, before the API; answer with the typed envelope.
    error_page 413 = @payload_too_large;
    location @payload_too_large {
      types { }
      default_type application/json;
      add_header Cache-Control "no-store" always;
      include /etc/seyra/security-headers.conf;
      return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"request body exceeds 64 KiB","request_id":"$request_id"}}';
    }

    # Operator-only diagnostics stay inside the backend network. Prefix match on the normalized URI
    # (percent-decoding, dot segments and merged slashes are resolved before matching), so no variant
    # reaches the API; omission from the OpenAPI document alone would not protect it.
    location ^~ /api/v1/map/diagnostics {
      types { }
      default_type application/json;
      add_header Cache-Control "no-store" always;
      include /etc/seyra/security-headers.conf;
      return 404 '{"error":{"code":"NOT_FOUND","message":"no such endpoint","request_id":"$request_id"}}';
    }

    location /api/ {
      proxy_pass http://seyra_api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_read_timeout 130s;
      proxy_buffering on;
    }
    location /health/ {
      proxy_pass http://seyra_api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
    }

    location ~ "^/maps/(?<ds>[a-z0-9][a-z0-9-]{2,79})/tiles/(?<z>[0-9]|1[0-6])/(?<x>[0-9]{1,5})/(?<y>[0-9]{1,5})\.pbf$" {
      if ($ds_active = 0) { rewrite ^ /__seyra/dataset-mismatch last; }
      proxy_pass http://seyra_tegola/maps/${SEYRA_TEGOLA_MAP}/$z/$x/$y.pbf;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      # Identity bodies from Tegola keep the cache independent of client Accept-Encoding;
      # Nginx compresses towards clients that ask for it.
      proxy_set_header Accept-Encoding "";
      gzip on;
      gzip_types application/vnd.mapbox-vector-tile application/x-protobuf;
      gzip_min_length 256;
      gzip_vary on;
      proxy_cache seyra_tiles;
      proxy_cache_key $uri;
      proxy_cache_valid 200 7d;
      proxy_cache_lock on;
      proxy_ignore_headers Cache-Control Expires Set-Cookie;
      proxy_hide_header Cache-Control;
      proxy_hide_header Access-Control-Allow-Origin;
      proxy_hide_header Access-Control-Allow-Methods;
      proxy_hide_header X-Content-Type-Options;
      # Tegola answers tiles outside the dataset bounds with 404 (and a mislabelled encoding);
      # an out-of-coverage tile is empty, so clients get 204. Provider failures are not cached.
      proxy_intercept_errors on;
      error_page 404 = @empty_tile;
      error_page 500 502 503 504 = @tiles_unavailable;
      add_header Cache-Control "public, max-age=86400" always;
      include /etc/seyra/security-headers.conf;
      add_header X-Seyra-Dataset $ds always;
    }
    location @empty_tile {
      add_header Cache-Control "public, max-age=86400" always;
      include /etc/seyra/security-headers.conf;
      return 204;
    }
    location @tiles_unavailable {
      types { }
      default_type application/json;
      add_header Cache-Control "no-store" always;
      include /etc/seyra/security-headers.conf;
      return 503 '{"error":{"code":"PROVIDER_UNAVAILABLE","message":"tile provider unavailable","request_id":"$request_id"}}';
    }
    location ~ "^/maps/(?<ds>[a-z0-9][a-z0-9-]{2,79})/(?<file>tiles\.json|styles/(light|dark)-(fa|en)\.json)$" {
      if ($ds_active = 0) { rewrite ^ /__seyra/dataset-mismatch last; }
      alias /srv/seyra/release/maps/$file;
      default_type application/json;
      sub_filter_types application/json;
      sub_filter_once off;
      sub_filter '__SEYRA_BASE__' '$scheme://$http_host';
      add_header Cache-Control "no-cache" always;
      include /etc/seyra/security-headers.conf;
    }
    location ~ "^/maps/(?<ds>[a-z0-9][a-z0-9-]{2,79})/fonts/(?<file>(Vazirmatn Regular|Vazirmatn Bold)/[0-9]{1,5}-[0-9]{1,5}\.pbf|files/Vazirmatn-(Regular|Bold)\.woff2)$" {
      if ($ds_active = 0) { rewrite ^ /__seyra/dataset-mismatch last; }
      alias /usr/share/seyra/assets/fonts/$file;
      add_header Cache-Control "public, max-age=604800, immutable" always;
      include /etc/seyra/security-headers.conf;
    }
    location ~ "^/maps/(?<ds>[a-z0-9][a-z0-9-]{2,79})/sprites/(?<file>(light|dark)(@2x)?\.(png|json))$" {
      if ($ds_active = 0) { rewrite ^ /__seyra/dataset-mismatch last; }
      alias /usr/share/seyra/assets/sprites/$file;
      add_header Cache-Control "public, max-age=604800" always;
      include /etc/seyra/security-headers.conf;
    }
    # Error bodies generated here are JSON whatever the requested extension (.pbf/.png/...):
    # `types {}` stops nginx from labelling them by the URI extension.
    location = /__seyra/dataset-mismatch {
      internal;
      types { }
      default_type application/json;
      add_header Cache-Control "no-store" always;
      include /etc/seyra/security-headers.conf;
      return 404 '{"error":{"code":"DATASET_MISMATCH","message":"dataset is not the active release","request_id":"$request_id"}}';
    }
    location /maps/ { types { } default_type application/json; return 404 '{"error":{"code":"NOT_FOUND","message":"unknown map resource","request_id":"$request_id"}}'; }
    location = /licenses/vazirmatn-ofl.txt { alias /usr/share/seyra/assets/licenses/Vazirmatn-OFL.txt; default_type text/plain; }

    root /usr/share/seyra/web;
    location /assets/ { try_files $uri =404; add_header Cache-Control "public, max-age=604800, immutable" always; include /etc/seyra/security-headers.conf; }
    location / { try_files $uri /index.html; add_header Cache-Control "no-cache" always; include /etc/seyra/security-headers.conf; }
